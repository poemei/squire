[Unit]
Description=Squire Rosaic Information Agent
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/squire
ExecStart=/opt/squire/bin/squire
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/squire/logs /opt/squire/state /opt/squire/rag

[Install]
WantedBy=multi-user.target
